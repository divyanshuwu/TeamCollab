# Supabase Dashboard > Connect > Transaction pooler for Vercel/serverless.
# Keep the full URI private and URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# Optional Aiven MySQL fallback. When DATABASE_URL is unreachable, the API
# uses this database (or MYSQL_DATABASE_URL) if it passes a SELECT 1 check.
AIVEN_DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DB_SSL_CA=ca.pem
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Comma-separated exact frontend origins, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
